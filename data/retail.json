  "knowledge": [
    {
      "id": "KB-001",
      "title": "低库存预警与补货规则",
      "category": "库存管理",
      "keywords": [
        "补货",
        "库存",
        "缺货",
        "断货",
        "安全库存",
        "replenish",
        "inventory"
      ],
      "content": "日均销量取最近 7 天售出件数除以 7。现货可售天数 = 现货 / 日均销量。安全库存覆盖 2 天；目标库存 = 向上取整(日均销量 × (采购提前期 + 2 天))。建议补货量 = max(0, 目标库存 − 现货 − 已确认在途)。在途不计入现货可售天数，需单独核对到货时间。任何采购或调拨都需要人工审批。"
    },
    {
      "id": "KB-002",
      "title": "销售下滑排查清单",
      "category": "经营诊断",
      "keywords": [
        "销售",
        "营收",
        "营业额",
        "业绩",
        "转化",
        "下降",
        "下滑",
        "sales"
      ],
      "content": "比较最近完整 7 天与此前 7 天的净销售额。销售额 = 客流 × 成交转化率 × 客单价。先核对客流、订单和客单价，再检查陈列、缺货、活动与客诉。环比下降超过 10% 时标记为重点排查；指标关联不能直接证明原因。"
    },
    {
      "id": "KB-003",
      "title": "退换货处理流程（模拟制度）",
      "category": "服务规范",
      "keywords": ["退货", "退款", "退换", "退换货", "换货", "小票", "return"],
      "content": "本演示制度：购买后 7 天内、商品完好且凭购买凭证可申请一般商品退换；质量问题交由值班主管核验。已拆封的个护用品、已开启的盲盒不适用一般退换。若缺少购买时间、商品品类或完好状态，先补齐信息，不能直接承诺退款。此为虚构演示制度，不代表企业规则或法律意见。"
    },
    {
      "id": "KB-004",
      "title": "端架与货架陈列巡检",
      "category": "门店执行",
      "keywords": ["陈列", "端架", "货架", "巡检", "display"],
      "content": "每日开店前与晚高峰前检查主通道端架、价签和试用装。畅销商品优先核对是否有货、有价签、能看见。拍照记录调整前后位置，再观察 3 天同时间段成交；不要把单日变化直接归因于陈列。"
    },
    {
      "id": "KB-005",
      "title": "促销活动与折扣权限",
      "category": "活动运营",
      "keywords": ["促销", "折扣", "活动", "优惠", "打折", "promotion"],
      "content": "活动上线前核对适用品类、活动时间与毛利底线。折扣方案、赠品额度与价格变更均需运营负责人审批。分析工具只生成建议，不直接发布活动或修改价格。"
    },
    {
      "id": "KB-006",
      "title": "门店日报口径",
      "category": "数据口径",
      "keywords": ["日报", "口径", "净销售", "客单价", "订单", "report"],
      "content": "净销售额为实收减去退款；订单数为支付完成订单。转化率 = 成交订单数 / 有效进店客流，客单价 = 净销售额 / 成交订单数。若分母为 0，指标应显示不可计算。数据只有聚合指标，不包含顾客个人信息。"
    },
    {
      "id": "KB-007",
      "title": "调拨与在途到货检查",
      "category": "库存管理",
      "keywords": ["调拨", "在途", "到货", "采购", "物流", "transfer"],
      "content": "调拨前核对调出店余量、调入店需求和预计到货时间；调拨或采购计划提交主管审批后执行。在途货品可能延期，预计缺货窗口需要单独检查。不能仅凭在途数量认定不会断货。"
    },
    {
      "id": "KB-008",
      "title": "服务投诉升级机制",
      "category": "服务规范",
      "keywords": ["投诉", "客诉", "差评", "服务", "complaint"],
      "content": "记录顾客反馈、涉及商品和发生时间，避免采集不必要的个人信息。涉及产品质量或人身安全的反馈应交由值班主管及时处理。门店助手只能给出处理清单，不能替代主管承诺赔偿。"
    },
    {
      "id": "KB-009",
      "title": "收货验收与数量差异",
      "category": "库存管理",
      "keywords": ["验收", "签收", "少件", "破损", "收货"],
      "content": "模拟制度：收货时逐项核对送货单、商品编码、件数和外箱状态。少件或破损应拍照并记录批次，差异未核实前不按送货单全量入账。此模拟流程只形成差异记录，由主管确认处理。"
    },
    {
      "id": "KB-010",
      "title": "盘点差异复核流程",
      "category": "库存管理",
      "keywords": ["盘点", "账实", "复点", "差异"],
      "content": "模拟制度：盘点差异先安排另一人复点，再核对未入账收货、退换和调拨单。记录实盘数、账面数及差异原因；未经复核不得直接调整账面数量。此模拟流程不修改库存系统。"
    },
    {
      "id": "KB-011",
      "title": "临期商品检查",
      "category": "门店执行",
      "keywords": ["临期", "保质期", "批次", "到期"],
      "content": "模拟制度：按批次记录到期日期，临近到期的商品单独标识并提交处置建议。到期、包装异常或状态不明的商品先隔离核验。处置、折价和销毁均由负责人审批，助手不自动改价。"
    },
    {
      "id": "KB-012",
      "title": "滞销商品观察口径",
      "category": "经营诊断",
      "keywords": ["滞销", "动销", "积压", "周转"],
      "content": "模拟制度：连续两个完整观察周没有成交的商品可列入动销复核清单。先确认期间可售、陈列正常且没有缺货，再核对季节和活动因素；不能把缺货期间的零成交当作滞销。"
    },
    {
      "id": "KB-013",
      "title": "新品试销记录",
      "category": "活动运营",
      "keywords": ["新品", "试销", "试卖", "样本"],
      "content": "模拟制度：新品先记录上架日期、初始配货和陈列位置，每日登记售出件数与缺货时段。样本不足时保留原始记录，不用一天表现推断长期需求；试销配货变更交由负责人确认。"
    },
    {
      "id": "KB-014",
      "title": "节假日需求修正",
      "category": "经营诊断",
      "keywords": ["节假日", "假期", "季节", "峰值"],
      "content": "模拟制度：常规补货公式使用稳定日均销量。节假日前应单列同类节假日记录、活动安排和供货周期变化，说明修正依据后手动调整销量或安全天数。系统不会自动预测假期需求。"
    },
    {
      "id": "KB-015",
      "title": "断网期间单据补录",
      "category": "门店执行",
      "keywords": ["断网", "离线", "补录", "重复单"],
      "content": "模拟制度：断网期间按时间记录单据号、商品和数量。恢复后先核对是否已成功同步，再逐笔补录并保留原始凭证；相同单据号不得重复入账。此工具只提供检查清单。"
    },
    {
      "id": "KB-016",
      "title": "交接班异常清单",
      "category": "门店执行",
      "keywords": ["交接", "班次", "待办", "交班"],
      "content": "模拟制度：交接时逐项登记待验收包裹、未完成客诉、待主管确认的异常及处理截止时间。每项记录接手人和当前状态，避免只在聊天中口头交接。无需记录顾客不必要的个人信息。"
    },
    {
      "id": "KB-017",
      "title": "活动效果对比口径",
      "category": "数据口径",
      "keywords": ["对照", "同期", "归因", "效果"],
